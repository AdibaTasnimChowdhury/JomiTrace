# JomiTrace Environment Configuration Template
# Copy to .env or backend/.env for local overrides

# Backend Server Configuration
API_HOST=127.0.0.1
API_PORT=8000

# CORS Allowed Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Database Configuration (SQLite default for zero-setup local evaluation)
DATABASE_URL=sqlite:///./jomitrace.db

# Project & Rule Specification
PROJECT_NAME=JomiTrace
RULE_VERSION=0.2
